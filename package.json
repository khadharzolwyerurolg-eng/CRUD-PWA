{
  "name": "users-offline-first",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "test": "npm test --workspace server",
    "start": "npm start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
